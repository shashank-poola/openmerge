# OpenMerge API and worker configuration.
# Copy to apps/server/.env and fill in the values. Never commit the real file.

PORT=8000

# PostgreSQL from docker-compose.yml (published on host port 5433)
DATABASE_URL=postgresql://openmerge:password@localhost:5433/openmerge_db

# Redis from docker-compose.yml. Required in production.
REDIS_URL=redis://localhost:6379

# Signs dashboard sessions. Use a long random string.
SERVER_JWT_SECRET=

# GitHub OAuth app, used for dashboard sign-in
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SERVER=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# GitHub App, used to receive webhooks and post reviews
GITHUB_APP_ID=
GITHUB_APP_NAME=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# PEM private key. Keep the line breaks, or use \n inside quotes.
GITHUB_PRIVATE_KEY=

# Model providers. Groq is required; Gemini is optional and runs first when set.
GROQ_API_KEY=
GEMINI_API_KEY=
